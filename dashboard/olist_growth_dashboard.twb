  <worksheet name="Monthly Delivered Orders and Product Value"><layout-options><title><formatted-text><run fontname="Arial" fontsize="13" bold="true">Monthly Delivered Orders and Product Value</run></formatted-text></title></layout-options><table><view><datasources><datasource name="federated.olist_monthly" caption="tableau_monthly_trend"/><datasource name="Parameters"/></datasources><datasource-dependencies datasource="federated.olist_monthly"><column name="[order_month]" caption="Purchase Month" datatype="date" role="dimension" type="ordinal"/><column-instance column="[order_month]" derivation="Month-Trunc" name="[tmn:order_month:qk]" pivot="key" type="quantitative"/><column name="[trend_value]" caption="Orders / Product Value (BRL)" datatype="real" role="measure" type="quantitative"><calculation class="tableau" formula="IF [Parameters].[Trend Metric] = &quot;Delivered orders&quot; THEN [delivered_orders] ELSE [product_revenue] END"/></column><column-instance column="[trend_value]" derivation="Sum" name="[sum:trend_value:qk]" pivot="key" type="quantitative"/><column name="[delivered_orders]" caption="Delivered Orders" datatype="integer" role="measure" type="quantitative" default-format="n#,##0"/><column-instance column="[delivered_orders]" derivation="Sum" name="[sum:delivered_orders:qk]" pivot="key" type="quantitative"/><column name="[product_revenue]" caption="Product Value (BRL)" datatype="real" role="measure" type="quantitative" default-format="c&quot;R$ &quot;#,##0.00;-&quot;R$ &quot;#,##0.00"/><column-instance column="[product_revenue]" derivation="Sum" name="[sum:product_revenue:qk]" pivot="key" type="quantitative"/><column name="[avg_order_value]" caption="Avg Order Value (BRL)" datatype="real" role="measure" type="quantitative" default-format="c&quot;R$ &quot;#,##0.00;-&quot;R$ &quot;#,##0.00"/><column-instance column="[avg_order_value]" derivation="Sum" name="[sum:avg_order_value:qk]" pivot="key" type="quantitative"/><column name="[year_filter]" caption=